# Local Postgres: docker compose up -d
DATABASE_URL=postgresql://stockping:stockping@localhost:5432/stockping

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_inventory,read_products,read_locations
SHOPIFY_APP_URL=https://localhost
SHOPIFY_BILLING_TEST=1
SKIP_BILLING=1

# Production on Railway:
# SHOPIFY_APP_URL=https://your-app.up.railway.app
# SHOPIFY_BILLING_TEST=0
# SKIP_BILLING=

RESEND_API_KEY=
RESEND_FROM_EMAIL=StockPing <alerts@yourdomain.com>
