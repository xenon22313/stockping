generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model ShopSettings {
  shop             String   @id
  enabled          Boolean  @default(true)
  threshold        Int      @default(5)
  email            String?
  telegramBotToken String?
  telegramChatId   String?
  notifyUrl        String?
  cooldownHours    Int      @default(24)
  updatedAt        DateTime @updatedAt
}

model InventoryWatch {
  id              String    @id @default(cuid())
  shop            String
  inventoryItemId String
  locationId      String
  lastAvailable   Int
  belowThreshold  Boolean   @default(false)
  lastAlertedAt   DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([shop, inventoryItemId, locationId])
}

model AlertLog {
  id              String   @id @default(cuid())
  shop            String
  inventoryItemId String
  locationId      String
  title           String
  sku             String?
  available       Int
  channels        String
  createdAt       DateTime @default(now())

  @@index([shop, createdAt])
}
